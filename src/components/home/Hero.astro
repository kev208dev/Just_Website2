---
import { site } from '../../lib/data';
import { routes, withBase } from '../../lib/paths';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage aria-hidden="true">
    <picture>
      <source media="(max-aspect-ratio: 1/1)" srcset={withBase('images/brand/hero-logo-portrait.webp')} />
      <img class="hero__poster" src={withBase('images/brand/hero-logo.webp')} alt="" width="1920" height="1200" fetchpriority="high" />
    </picture>
  </div>

  <h1 class="hero__title" id="hero-title" data-hero-title>
    <span class="hero__line"><span>From zero.</span></span>
    <span class="hero__line hero__line--b"><span>To <em class="t-serif">anything.</em></span></span>
  </h1>

  <div class="hero__bottom container">
    <p class="hero__motto">{site.mottoKo}</p>
    <a class="hero__explore t-caps" href={routes.explore}>Explore <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 68% 34%, #17181c 0%, rgb(8 9 11 / 0) 70%),
      var(--c-bg);
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 900ms var(--ease-out);
  }

  .hero.is-live .hero__poster {
    opacity: 0;
  }

  .hero__title {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(108px, 15svh, 168px);
    z-index: 2;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.4rem, 0.4rem + 11.6vw, 15.5rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .hero__title em {
    font-size: 1.06em;
    letter-spacing: -0.035em;
    color: var(--c-ivory);
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  /* Room for the serif descenders (y, g) inside the mask. */
  .hero__line--b {
    padding-bottom: 0.2em;
    margin-bottom: -0.15em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__line--b {
    padding-left: 0.62em;
  }

  .js .hero__line > span {
    transform: translate3d(0, 104%, 0);
    animation: hero-line 1.25s var(--ease-out) 0.1s forwards;
  }

  .js .hero__line--b > span {
    animation-delay: 0.22s;
  }

  @keyframes hero-line {
    to {
      transform: none;
    }
  }

  .hero__bottom {
    position: absolute;
    inset: auto 0 calc(28px + env(safe-area-inset-bottom));
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 16px;
    font-size: var(--fs-small);
    color: var(--c-soft);
  }

  .hero__explore {
    justify-self: end;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--c-line-strong);
    transition: border-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out);
  }

  .hero__explore:hover {
    color: var(--c-ivory);
    border-color: var(--c-bronze);
  }

  @media (max-width: 820px) {
    .hero__title {
      bottom: 132px;
    }

    .hero__line--b {
      padding-left: 0;
    }
  }
</style>
