---
import RevealText from '../motion/RevealText.astro';

interface Props {
  kicker: string;
  lines: string[];
  intro?: string;
  count?: string;
  size?: 'mega' | 'h1';
}
const { kicker, lines, intro, count, size = 'mega' } = Astro.props;
---

<header class="page-hero container">
  <div class="page-hero__top">
    <p class="section-label t-caps">{kicker}</p>
    {count && <p class="t-caps t-muted t-num">{count}</p>}
  </div>
  <RevealText as="h1" lines={lines} class:list={['page-hero__title', 't-display', `is-${size}`]} />
  {
    intro && (
      <p class="page-hero__intro t-lead reveal-fade" data-reveal style="--delay:300ms">
        {intro}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-hero {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    padding-bottom: clamp(56px, 8vw, 120px);
  }

  .page-hero__top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .page-hero__title.is-mega {
    font-size: var(--fs-mega);
    line-height: 0.82;
  }

  .page-hero__title.is-h1 {
    font-size: var(--fs-h1);
  }

  .page-hero__intro {
    max-width: 34ch;
    color: var(--c-muted);
    margin-left: auto;
  }
</style>
