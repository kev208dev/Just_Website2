---
import { navItems, routes } from '../../lib/paths';
import { site } from '../../lib/data';
interface Props {
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    {
      cta && (
        <>
          <a class="footer-cta" href={routes.contact} data-cursor="link">
            <span class="t-caps t-muted">Contact</span>
            <span class="footer-cta__type t-display">
              Let’s make
              <br />
              something real.
            </span>
          </a>
          <hr class="rule" />
        </>
      )
    }

    <div class="footer-grid">
      <div class="footer-brand">
        <strong>JUST<sup>®</sup></strong>
        <p class="t-muted">{site.tagline}<br />{site.mottoKo}</p>
      </div>
      <ul class="footer-nav">
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <ul class="footer-contact">
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li>
          <a href={site.contact.instagram.url} target="_blank" rel="noopener noreferrer">
            Instagram {site.contact.instagram.handle}
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-base t-caps t-muted">
      <span>© {year} JUST Digital Atelier</span>
      <span>Build. Prove.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(56px, 8vw, 120px) 32px;
    border-top: 1px solid var(--c-line);
    background: var(--c-bg);
  }

  .footer-cta {
    display: grid;
    padding-top: calc(var(--section-y) - clamp(56px, 8vw, 120px));
    gap: 24px;
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .footer-cta__type {
    font-size: var(--fs-h1);
    transition: color var(--dur-std) var(--ease-out);
  }

  .footer-cta:hover .footer-cta__type {
    color: var(--c-accent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 40px;
    padding-block: 40px 72px;
  }

  .footer-brand strong {
    display: block;
    font-family: var(--font-latin);
    font-size: 1.5rem;
    letter-spacing: -0.06em;
    margin-bottom: 12px;
  }

  .footer-brand sup {
    font-size: 0.5em;
    font-weight: 400;
  }

  .footer-nav,
  .footer-contact {
    display: grid;
    gap: 8px;
    align-content: start;
    font-family: var(--font-latin);
  }

  .footer-nav a,
  .footer-contact a {
    color: var(--c-muted);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--c-text);
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
