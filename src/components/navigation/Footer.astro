---
import { NAV, SITE } from "../../lib/site";
import { url } from "../../lib/paths";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <a class="footer-cta" href={url("contact")} data-cursor="view" data-cursor-label="Contact">
      <span class="eyebrow eyebrow--accent">Next — Contact</span>
      <span class="footer-cta__title">Let's make<br /><em>something real.</em></span>
    </a>

    <div class="footer-grid">
      <div class="footer-col">
        <p class="eyebrow">JUST Digital Atelier</p>
        <p class="footer-motto">{SITE.collective}<br />{SITE.motto}.</p>
      </div>
      <nav class="footer-col" aria-label="푸터 메뉴">
        <p class="eyebrow">Index</p>
        <ul>
          <li><a class="u-link" href={url()}>Home</a></li>
          {NAV.map((item) => <li><a class="u-link" href={url(item.href)}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer-col">
        <p class="eyebrow">Contact</p>
        <ul>
          <li><a class="u-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a class="u-link" href={SITE.instagram.url} target="_blank" rel="noopener noreferrer">Instagram {SITE.instagram.handle}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <span>© {year} JUST</span>
      <span>Build. Prove.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: clamp(5rem, 10vw, 9rem) 2rem;
    border-top: 1px solid var(--c-line);
    background: var(--c-bg);
  }

  .footer-cta {
    display: block;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .footer-cta__title {
    display: block;
    margin-top: 1.25rem;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(3rem, 9vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    transition: color var(--d-standard) var(--ease-standard);
  }

  .footer-cta__title em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1px var(--c-text);
    transition:
      color var(--d-standard) var(--ease-standard),
      -webkit-text-stroke-color var(--d-standard);
  }

  .footer-cta:hover .footer-cta__title em {
    color: var(--c-accent);
    -webkit-text-stroke-color: var(--c-accent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.4fr;
    gap: var(--gutter);
    padding-block: 2.5rem;
    border-top: 1px solid var(--c-line);
  }

  .footer-col .eyebrow {
    margin-bottom: 1rem;
  }

  .footer-col ul {
    display: grid;
    gap: 0.4rem;
    font-family: var(--f-display);
    font-size: 0.95rem;
  }

  .footer-motto {
    font-family: var(--f-display);
    font-size: 1.05rem;
    line-height: 1.5;
    color: rgba(241, 238, 232, 0.8);
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-col:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
