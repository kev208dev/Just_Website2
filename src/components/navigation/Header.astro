---
import { navItems, routes, type NavKey } from '../../lib/paths';

interface Props {
  current: NavKey;
}
const { current } = Astro.props;
---

<header class="site-header" data-header>
  <a class="brand" href={routes.home} aria-label="JUST 홈" data-cursor="link">
    <span class="brand__word">JUST</span><sup>®</sup>
  </a>

  <nav class="nav" aria-label="주요 메뉴">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.key ? 'page' : undefined}
              data-cursor="link"
            >
              <span class="nav__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-toggle
  >
    <span class="menu-toggle__label">Menu</span>
    <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label="모바일 메뉴">
    <ul>
      <li style="--i:0">
        <a href={routes.home} aria-current={current === 'home' ? 'page' : undefined}>
          Home
        </a>
      </li>
      {
        navItems.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    align-items: flex-start;
    font-family: var(--font-latin);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .brand sup {
    font-size: 0.5em;
    font-weight: 400;
    margin-left: 2px;
    letter-spacing: 0;
    top: 0;
    line-height: 1;
  }

  .nav ul {
    display: flex;
    gap: clamp(20px, 3vw, 48px);
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-latin);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-block: 8px;
  }

  .nav__label {
    position: relative;
  }

  .nav__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-std) var(--ease-out);
  }

  .nav a:hover .nav__label::after,
  .nav a[aria-current='page'] .nav__label::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 12px;
    height: 44px;
    font-family: var(--font-latin);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu-toggle__icon {
    position: relative;
    width: 22px;
    height: 10px;
  }

  .menu-toggle__icon i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-std) var(--ease-out), top var(--dur-std) var(--ease-out);
  }

  .menu-toggle__icon i:first-child {
    top: 0;
  }

  .menu-toggle__icon i:last-child {
    top: 8px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:first-child {
    top: 4px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon i:last-child {
    top: 4px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-h) + 32px) var(--gutter) calc(24px + env(safe-area-inset-bottom));
    background: var(--c-bg);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms var(--ease-out);
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
  }

  .mobile-menu ul {
    display: grid;
    gap: 4px;
  }

  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 13vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.02;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 600ms var(--ease-out),
      transform 600ms var(--ease-out);
    transition-delay: calc(120ms + var(--i) * 50ms);
  }

  .mobile-menu.is-open a {
    opacity: 1;
    transform: none;
  }

  .mobile-menu a[aria-current='page'] {
    color: var(--c-accent);
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }
</style>
