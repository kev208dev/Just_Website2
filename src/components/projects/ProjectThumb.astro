---
import type { Project } from "../../lib/data";
import { projectImage } from "../../lib/data";

interface Props {
  project: Project;
  eager?: boolean;
}

/* Renders the project image (or a typographic card) with a shared-element
   transition name, so it morphs between the gallery, works index and detail hero.
   Use it at most once per project on a page. */
const { project, eager = false } = Astro.props;
const name = `project-${project.slug}`;
const src = projectImage(project);
const [w, h] = project.imageSize ?? [1600, 1000];
---

{
  src ? (
    <img
      class="thumb-img"
      src={src}
      width={w}
      height={h}
      alt={project.imageAlt ?? ""}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      transition:name={name}
    />
  ) : (
    <span class="type-thumb" style={`--accent:${project.accent}`} transition:name={name}>
      <span class="type-thumb__meta">{[project.category, project.year].filter(Boolean).join(" · ")}</span>
      <span class="type-thumb__title">{project.title}</span>
      <span class="type-thumb__orbit" aria-hidden="true"></span>
    </span>
  )
}

<style>
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .type-thumb {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: clamp(1rem, 2.4vw, 1.75rem);
    background:
      linear-gradient(rgba(241, 238, 232, 0.04) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgba(241, 238, 232, 0.04) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(135deg, #1c1d20, #0e0f10);
    overflow: hidden;
  }

  .type-thumb__meta {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .type-thumb__title {
    font-family: var(--f-text);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .type-thumb__orbit {
    position: absolute;
    right: 8%;
    top: 12%;
    width: 18%;
    aspect-ratio: 1;
    border: 1px solid rgba(242, 174, 69, 0.55);
    border-radius: 50%;
  }

  .type-thumb__orbit::after {
    content: "";
    position: absolute;
    right: -5px;
    top: 50%;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--c-accent);
  }
</style>
