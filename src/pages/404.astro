---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/paths";
---

<BaseLayout title="Not found" description="요청한 페이지를 찾을 수 없습니다." footer={false}>
  <div class="page not-found container">
    <p class="eyebrow eyebrow--accent">Error 404</p>
    <h1 class="nf-title" data-reveal="lines">
      <span class="split-line"><span>Zero.</span></span>
    </h1>
    <p class="lead">이 주소에는 아직 아무것도 없습니다. 0에서 다시 시작해 볼까요?</p>
    <div class="nf-actions">
      <a class="button" href={url()}>Back to home</a>
      <a class="button button--ghost" href={url("work")}>See the work</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .nf-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(5rem, 22vw, 22rem);
    line-height: 0.82;
    letter-spacing: -0.07em;
    text-transform: uppercase;
    margin-left: -0.05em;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
