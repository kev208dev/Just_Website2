---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectThumb from "../../components/projects/ProjectThumb.astro";
import { categories, projects, projectUrl, projectImage } from "../../lib/data";

const count = String(projects.length).padStart(2, "0");
const countBy = (c: string) => projects.filter((p) => p.category === c).length;
---

<BaseLayout title="Work" description="JUST가 직접 기획하고 만든 프로젝트 아카이브 — 게임, 웹앱, 창업 프로젝트.">
  <div class="page work-page" data-works-page>
    <header class="page-head container">
      <div class="page-head__meta">
        <span class="eyebrow eyebrow--accent">Index of works</span>
        <span class="eyebrow">{count} projects</span>
      </div>
      <h1 class="page-head__title" data-reveal="lines">
        <span class="split-line"><span>Work<sup>{count}</sup></span></span>
      </h1>
      <div class="page-head__intro">
        <p class="lead" data-reveal="fade">
          아이디어를 직접 만들어 보고, 실제로 작동하는 결과물로 증명합니다. JUST 멤버들이 만든 게임과 웹앱, 그리고 수상 아카이브에 오른
          창업 프로젝트입니다.
        </p>
      </div>
    </header>

    <div class="works-toolbar container" data-reveal="fade">
      <div class="works-filters" role="group" aria-label="카테고리 필터">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All <span class="count">{projects.length}</span></button>
        {
          categories.map((c) => (
            <button class="chip" type="button" data-filter={c} aria-pressed="false">
              {c} <span class="count">{countBy(c)}</span>
            </button>
          ))
        }
      </div>
      <div class="works-views" role="group" aria-label="보기 방식">
        <button class="view-btn" type="button" data-view="grid" aria-pressed="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5"></rect><rect x="9" y="1.5" width="5.5" height="5.5"></rect><rect x="1.5" y="9" width="5.5" height="5.5"></rect><rect x="9" y="9" width="5.5" height="5.5"></rect></svg>
          Grid
        </button>
        <button class="view-btn" type="button" data-view="list" aria-pressed="false">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 3.5h13M1.5 8h13M1.5 12.5h13"></path></svg>
          List
        </button>
      </div>
    </div>

    <section class="container" aria-label="프로젝트 목록">
      <p class="sr-only" aria-live="polite" data-works-status></p>
      <ol class="works is-grid" data-works>
        {
          projects.map((p, i) => (
            <li class="work" data-category={p.category} data-flip-id={p.slug}>
              <a
                class="work__link"
                href={projectUrl(p.slug)}
                data-cursor="view"
                data-preview={projectImage(p) ?? ""}
                data-cursor-caption={p.title}
              >
                <figure class="work__media">
                  <ProjectThumb project={p} eager={i < 2} />
                </figure>
                <div class="work__info">
                  <span class="work__index">{String(i + 1).padStart(2, "0")}</span>
                  <h2 class="work__title">{p.title}</h2>
                  <span class="work__cat">{p.category}</span>
                  <span class="work__year">{p.year ?? "—"}</span>
                  <p class="work__summary">{p.summary}</p>
                  {p.stack.length > 0 && (
                    <ul class="work__stack" aria-label="기술 스택">
                      {p.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  )}
                  <span class="work__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="M4 12L12 4M5.5 4H12v6.5"></path></svg>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
    <img class="works-preview" data-works-preview alt="" aria-hidden="true" />
  </div>
</BaseLayout>

<style>
  .works-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-block: 1px solid var(--c-line);
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    background: rgba(9, 10, 11, 0.86);
    backdrop-filter: blur(10px);
  }

  .works-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .works-views {
    display: flex;
    gap: 0.25rem;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    padding: 0 12px;
    font-family: var(--f-display);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
    transition: color var(--d-micro);
  }

  .view-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .view-btn[aria-pressed="true"] {
    color: var(--c-text);
  }

  .view-btn:hover {
    color: var(--c-text);
  }

  /* ---------------------------------------------------- shared */

  .works {
    padding-bottom: var(--section);
  }

  .work[hidden] {
    display: none;
  }

  .work__link {
    display: block;
  }

  .work__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--c-surface);
  }

  .work__media :global(img),
  .work__media :global(.type-thumb) {
    transition: transform 900ms var(--ease-out);
  }

  .work__link:hover .work__media :global(img),
  .work__link:hover .work__media :global(.type-thumb) {
    transform: scale(1.045);
  }

  .work__index {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    color: var(--c-accent);
    letter-spacing: 0.1em;
  }

  .work__title {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .work__cat,
  .work__year {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .work__summary {
    color: rgba(241, 238, 232, 0.68);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .work__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .work__stack li {
    padding: 2px 9px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-family: var(--f-display);
    font-size: 0.7rem;
    color: rgba(241, 238, 232, 0.7);
  }

  .work__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    transition: transform var(--d-standard) var(--ease-out);
  }

  .work__link:hover .work__arrow svg {
    transform: translate(3px, -3px);
  }

  /* ---------------------------------------------------- grid: asymmetric editorial layout */

  .works.is-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gutter);
    row-gap: clamp(3rem, 7vw, 6.5rem);
  }

  .works.is-grid .work:nth-child(6n + 1) {
    grid-column: 1 / span 7;
  }
  .works.is-grid .work:nth-child(6n + 2) {
    grid-column: 9 / span 4;
    margin-top: clamp(4rem, 12vw, 11rem);
  }
  .works.is-grid .work:nth-child(6n + 3) {
    grid-column: 2 / span 5;
  }
  .works.is-grid .work:nth-child(6n + 4) {
    grid-column: 7 / span 6;
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .works.is-grid .work:nth-child(6n + 5) {
    grid-column: 1 / span 4;
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .works.is-grid .work:nth-child(6n + 6) {
    grid-column: 6 / span 7;
  }

  .works.is-grid .work__media {
    aspect-ratio: 16 / 10;
  }

  .works.is-grid .work__info {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 0.9rem;
    row-gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .works.is-grid .work__title {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
  }

  .works.is-grid .work__cat {
    justify-self: end;
  }

  .works.is-grid .work__year {
    display: none;
  }

  .works.is-grid .work__summary,
  .works.is-grid .work__stack {
    grid-column: 2 / -1;
  }

  .works.is-grid .work__summary {
    max-width: 34em;
  }

  .works.is-grid .work__arrow {
    display: none;
  }

  /* ---------------------------------------------------- list: typographic index */

  .works.is-list {
    border-top: 1px solid var(--c-line);
  }

  .works.is-list .work {
    border-bottom: 1px solid var(--c-line);
  }

  .works.is-list .work__media {
    display: none;
  }

  .works.is-list .work__info {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.4fr) minmax(0, 0.7fr) 5rem 2rem;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(1.1rem, 2.4vw, 1.9rem);
    transition:
      padding var(--d-standard) var(--ease-out),
      color var(--d-micro);
  }

  .works.is-list .work__title {
    font-size: clamp(1.5rem, 3.6vw, 3.4rem);
    letter-spacing: -0.035em;
    transition: transform var(--d-standard) var(--ease-out);
  }

  .works.is-list .work__link:hover .work__title {
    transform: translateX(0.4em);
    color: var(--c-accent);
  }

  .works.is-list .work__summary,
  .works.is-list .work__stack {
    display: none;
  }

  .works-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: min(26vw, 360px);
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r-md);
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 260ms var(--ease-standard),
      scale 420ms var(--ease-out);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .works-preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  @media (max-width: 860px) {
    .works.is-grid {
      grid-template-columns: 1fr;
    }
    .works.is-grid .work:nth-child(n) {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .works.is-list .work__info {
      grid-template-columns: 2.4rem 1fr auto;
    }
    .works.is-list .work__year,
    .works.is-list .work__arrow {
      display: none;
    }
    .works-preview {
      display: none;
    }
  }
</style>

<script>
  import "../../scripts/works";
</script>
