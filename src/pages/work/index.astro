---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { getProjects } from '../../lib/data';
import { routes, withBase } from '../../lib/paths';

const projects = await getProjects();
const categories = [...new Set(projects.map((p) => p.data.category))];
const count = (c: string) => projects.filter((p) => p.data.category === c).length;
// Asymmetric editorial placement, cycled for any number of projects.
const placements = ['wide', 'narrow-low', 'narrow', 'wide-low', 'mid'];
---

<BaseLayout title="Work" current="work" description="JUST가 0에서 만든 프로젝트 아카이브.">
  <div class="page">
    <PageHero
      kicker="Selected works"
      lines={['All <em class="t-serif">works</em>']}
      count={`(${String(projects.length).padStart(2, '0')})`}
      intro="아이디어를 발견하고, 실험하고, 기술로 실제 결과물을 만듭니다. JUST 멤버들이 직접 만든 작업들입니다."
    />

    <section class="works container" data-works data-view="grid" aria-label="프로젝트 목록">
      <div class="works__bar">
        <div class="works__filters" role="group" aria-label="카테고리 필터">
          <button class="chip" type="button" data-filter="all" aria-pressed="true">
            All <span class="count t-num">{projects.length}</span>
          </button>
          {
            categories.map((c) => (
              <button class="chip" type="button" data-filter={c} aria-pressed="false">
                {c} <span class="count t-num">{count(c)}</span>
              </button>
            ))
          }
        </div>
        <div class="works__views" role="group" aria-label="보기 방식">
          <button class="works__view" type="button" data-view-btn="grid" aria-pressed="true">Grid</button>
          <button class="works__view" type="button" data-view-btn="list" aria-pressed="false">List</button>
        </div>
      </div>

      <ol class="works__items">
        {
          projects.map((p, i) => (
            <li class={`work-item is-${placements[i % placements.length]}`} data-category={p.data.category} data-flip-id={p.id}>
              <a href={routes.project(p.id)} class="work-item__link" data-cursor="view" data-preview={withBase(p.data.coverThumb)} style={`--accent:${p.data.art.accent}`}>
                <figure class="work-item__media reveal-mask" data-reveal>
                  <img
                    src={withBase(p.data.cover)}
                    alt={`${p.data.title} 키비주얼 — ${p.data.art.direction}`}
                    width="1920"
                    height="1200"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </figure>
                <div class="work-item__meta">
                  <span class="work-item__num t-num">{String(i + 1).padStart(2, '0')}</span>
                  <h2 class="work-item__title">{p.data.titleEn}</h2>
                  <span class="work-item__cat t-caps">{p.data.category}</span>
                  <span class="work-item__stack"><span class="work-item__ko">{p.data.title}</span> — <span class="t-serif">{p.data.art.tagline}</span></span>
                  <span class="work-item__year t-num">{p.data.year ?? '—'}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="works__preview" data-list-preview aria-hidden="true"><img alt="" /></div>
    </section>
  </div>
</BaseLayout>

<style>
  .works__bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 14px;
    margin-bottom: clamp(40px, 6vw, 80px);
    background: linear-gradient(var(--c-bg) 70%, transparent);
  }

  .works__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .works__views {
    display: flex;
    gap: 18px;
    font-family: var(--font-latin);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .works__view {
    color: var(--c-muted);
    padding: 8px 0;
    letter-spacing: inherit;
  }

  .works__view[aria-pressed='true'] {
    color: var(--c-text);
    box-shadow: inset 0 -1px 0 var(--c-accent);
  }

  /* ---------- Grid view ---------- */
  .works__items {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(16px, 2.4vw, 40px);
    row-gap: clamp(56px, 8vw, 120px);
    padding-bottom: var(--section-y);
  }

  .work-item {
    grid-column: span 6;
  }

  .work-item.is-wide {
    grid-column: 1 / span 7;
  }

  .work-item.is-narrow-low {
    grid-column: 9 / span 4;
    margin-top: 18vw;
  }

  .work-item.is-narrow {
    grid-column: 2 / span 4;
  }

  .work-item.is-wide-low {
    grid-column: 6 / span 7;
    margin-top: 10vw;
  }

  .work-item.is-mid {
    grid-column: 3 / span 6;
  }

  .work-item.is-hidden {
    display: none;
  }

  .work-item__link {
    display: grid;
    gap: 18px;
  }

  .work-item__media {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: var(--c-surface);
    aspect-ratio: 16 / 10;
  }

  .work-item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out), filter 600ms var(--ease-out);
  }

  .work-item__link:hover .work-item__media img {
    transform: scale(1.025);
  }

  .work-item__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 14px;
    row-gap: 4px;
  }

  .work-item__num {
    font-size: var(--fs-micro);
    color: var(--c-muted);
  }

  .work-item__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 1.8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .work-item__link:hover .work-item__title {
    color: var(--c-bone);
  }

  .work-item__num {
    color: var(--accent);
  }

  .work-item__stack .t-serif {
    font-size: 1.125em;
    color: var(--c-soft);
  }

  .work-item__cat {
    color: var(--c-muted);
  }

  .work-item__stack,
  .work-item__year {
    grid-column: 2 / span 2;
    font-size: var(--fs-small);
    color: var(--c-muted);
  }

  .work-item__year {
    display: none;
  }

  /* ---------- List view ---------- */
  .works[data-view='list'] .works__items {
    display: block;
    border-top: 1px solid var(--c-line);
  }

  .works[data-view='list'] .work-item {
    margin: 0;
    border-bottom: 1px solid var(--c-line);
  }

  .works[data-view='list'] .work-item__link {
    display: block;
    padding-block: clamp(18px, 2.6vw, 34px);
  }

  .works[data-view='list'] .work-item__media {
    display: none;
  }

  .works[data-view='list'] .work-item__meta {
    grid-template-columns: 60px minmax(0, 1fr) 140px minmax(0, 220px) 70px;
    align-items: center;
  }

  .works[data-view='list'] .work-item__title {
    font-size: clamp(1.75rem, 1rem + 3.4vw, 4.5rem);
    letter-spacing: -0.05em;
    transition:
      color var(--dur-micro) var(--ease-out),
      transform var(--dur-std) var(--ease-out);
  }

  .works[data-view='list'] .work-item__link:hover .work-item__title {
    transform: translateX(14px);
  }

  .works[data-view='list'] .work-item__stack,
  .works[data-view='list'] .work-item__year {
    grid-column: auto;
    display: block;
  }

  .works[data-view='list'] .work-item__year {
    text-align: right;
  }

  .works__preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: clamp(220px, 22vw, 360px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-s);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0) scale(0.85);
    transition:
      opacity 300ms var(--ease-out),
      scale 500ms var(--ease-out);
  }

  .works__preview.is-on {
    opacity: 1;
  }

  .works__preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .works__items {
      grid-template-columns: 1fr;
    }

    .work-item,
    .work-item[class*='is-'] {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .works[data-view='list'] .work-item__meta {
      grid-template-columns: 36px 1fr auto;
    }

    .works[data-view='list'] .work-item__stack {
      display: none;
    }

    .works__preview {
      display: none;
    }
  }
</style>

<script>
  import { initWorks } from '../../scripts/works';
  initWorks();
</script>
