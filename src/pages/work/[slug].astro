---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevealText from '../../components/motion/RevealText.astro';
import { getProjects, type Project } from '../../lib/data';
import { routes, withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length], total: projects.length },
  }));
}

interface Props {
  project: Project;
  next: Project;
  index: number;
  total: number;
}

const { project, next, index, total } = Astro.props;
const p = project.data;
const num = (i: number) => String(i + 1).padStart(2, '0');
const meta = [
  { label: 'Category', value: p.category },
  p.year ? { label: 'Year', value: String(p.year), note: p.yearSource } : null,
  p.stack.length ? { label: 'Stack', value: p.stack.join(', ') } : null,
  { label: 'Art direction', value: p.art.direction },
  p.members.length ? { label: 'Team', value: p.members.join(', ') } : null,
].filter(Boolean) as { label: string; value: string; note?: string }[];
const host = p.links.live?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<BaseLayout title={p.title} current="work" description={p.summary} ogImage={p.cover} bodyClass="is-project">
  <script is:inline define:vars={{ slug: project.id }}>
    try {
      if (sessionStorage.getItem('just:from-gallery') === slug) document.documentElement.classList.add('from-gallery');
    } catch (e) {}
  </script>
  <article
    class:list={['project', `tone-${p.art.tone}`]}
    data-project={project.id}
    style={`--accent:${p.art.accent};--surface:${p.art.surface}`}
  >
    <header class="p-hero" data-project-hero>
      <figure class="p-hero__media">
        <img src={withBase(p.cover)} alt={`${p.title} 키비주얼 — ${p.art.direction}`} width="1920" height="1200" fetchpriority="high" />
      </figure>
    </header>

    <section class="p-title container">
      <p class="p-title__ko">{p.title}</p>
      <RevealText as="h1" lines={[p.titleEn]} class="p-title__en" />
      <p class="p-title__tag t-serif reveal-fade" data-reveal>{p.art.tagline}</p>
    </section>

    <section class="p-intro container">
      <p class="section-label t-caps">Overview</p>
      <div class="p-intro__body">
        <p class="p-intro__lead reveal-fade" data-reveal>{p.summary}</p>
        <dl class="p-meta">
          {
            meta.map((m) => (
              <div>
                <dt class="t-caps t-muted">{m.label}</dt>
                <dd>
                  {m.value}
                  {m.note && <small class="t-muted">{m.note}</small>}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="p-links">
          {
            p.links.live && (
              <a class="button" href={p.links.live} target="_blank" rel="noopener noreferrer">
                Visit live <span aria-hidden="true">↗</span>
              </a>
            )
          }
          {
            p.links.github && (
              <a class="button button--ghost" href={p.links.github} target="_blank" rel="noopener noreferrer">
                GitHub <span aria-hidden="true">↗</span>
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="p-screen" aria-label="실제 화면">
      <div class="container">
        <p class="section-label t-caps">The product — real screen</p>
        <figure class="p-screen__frame reveal-mask" data-reveal>
          <div class="p-screen__bar" aria-hidden="true"><i></i><i></i><i></i>{host && <span>{host}</span>}</div>
          <img src={withBase(p.image)} alt={p.alt} width="1280" height={Math.round(1280 / p.imageAspect)} loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    {
      p.features.length > 0 && (
        <section class="p-block container">
          <p class="section-label t-caps">Features</p>
          <ol class="p-features">
            {p.features.map((f, i) => (
              <li class="reveal-fade" data-reveal style={`--delay:${i * 60}ms`}>
                <span class="t-num">{num(i)}</span>
                <span>{f}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      p.problem && (
        <section class="p-block container">
          <p class="section-label t-caps">Problem</p>
          <p class="t-lead">{p.problem}</p>
        </section>
      )
    }
    {
      p.process && (
        <section class="p-block container">
          <p class="section-label t-caps">Process</p>
          <p class="t-lead">{p.process}</p>
        </section>
      )
    }
    {
      p.outcomes.length > 0 && (
        <section class="p-block container">
          <p class="section-label t-caps">Outcomes</p>
          <ul class="p-features">
            {p.outcomes.map((o) => (
              <li>{o}</li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="p-next" aria-label="다음 프로젝트">
      <a href={routes.project(next.id)} class="p-next__link container" data-cursor="view" data-cursor-label="NEXT">
        <span class="t-caps t-muted">Next — {num((index + 1) % total)}</span>
        <span class="p-next__title">{next.data.titleEn}</span>
        <span class="p-next__tag t-serif">{next.data.art.tagline}</span>
        <span class="p-next__thumb"><img src={withBase(next.data.coverThumb)} alt="" loading="lazy" width="960" height="600" /></span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ---------- Hero: the key visual, full-bleed — the Explore zoom lands exactly here ---------- */
  .p-hero {
    position: relative;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: var(--surface);
  }

  .p-hero__media,
  .p-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .js .p-hero__media img {
    animation: hero-in 1.6s var(--ease-out) both;
  }

  :global(html.from-gallery) .p-hero__media img {
    animation: none;
  }

  @keyframes hero-in {
    from {
      scale: 1.08;
      opacity: 0.4;
    }
  }

  @media (max-aspect-ratio: 1/1) {
    .p-hero {
      height: auto;
      min-height: 0;
      padding-top: calc(var(--header-h) + 16px);
    }

    .p-hero__media,
    .p-hero__media img {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 16 / 10;
    }

  }

  /* ---------- Title band ---------- */
  .p-title {
    display: grid;
    gap: 22px;
    padding-block: clamp(72px, 10vw, 160px) clamp(40px, 6vw, 80px);
  }

  .p-title__ko {
    font-size: var(--fs-small);
    color: var(--c-soft);
  }

  .p-title__en {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.2rem, 0.4rem + 10vw, 13rem);
    line-height: 0.84;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }

  .p-title__tag {
    font-size: clamp(1.75rem, 1rem + 2.4vw, 3.5rem);
    color: var(--c-bone);
    justify-self: end;
  }

  /* ---------- Overview ---------- */
  .p-intro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    padding-block: clamp(40px, 6vw, 80px) var(--section-y);
    border-top: 1px solid var(--c-line);
  }

  .p-intro__lead {
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    line-height: 1.35;
    letter-spacing: -0.035em;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .p-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px 40px;
    padding-top: 24px;
    border-top: 1px solid var(--c-line);
    margin-bottom: 40px;
  }

  .p-meta dt {
    margin-bottom: 8px;
  }

  .p-meta dd small {
    display: block;
    font-size: var(--fs-micro);
    margin-top: 4px;
  }

  .p-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .p-links .button:hover {
    background: var(--accent);
  }

  /* ---------- Real screen ---------- */
  .p-screen {
    padding-bottom: var(--section-y);
  }

  .p-screen .section-label {
    margin-bottom: 28px;
  }

  .p-screen__frame {
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-line), 0 60px 120px -60px rgb(0 0 0 / 0.9);
    max-width: 1180px;
    margin-inline: auto;
  }

  .p-screen__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--c-line);
    background: var(--c-bg-2);
  }

  .p-screen__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-graphite);
  }

  .p-screen__bar span {
    margin-left: 14px;
    font-family: var(--font-latin);
    font-size: var(--fs-micro);
    color: var(--c-muted);
  }

  .p-screen__frame img {
    width: 100%;
  }

  /* ---------- Features ---------- */
  .p-block {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    padding-bottom: var(--section-y);
  }

  .p-features {
    display: grid;
    border-top: 1px solid var(--c-line);
  }

  .p-features li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding-block: 22px;
    border-bottom: 1px solid var(--c-line);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.375rem);
    letter-spacing: -0.01em;
  }

  .p-features .t-num {
    color: var(--accent);
    font-size: var(--fs-small);
  }

  .tone-light .p-features .t-num {
    color: var(--c-bone);
  }

  /* ---------- Next ---------- */
  .p-next {
    border-top: 1px solid var(--c-line);
  }

  .p-next__link {
    position: relative;
    display: grid;
    gap: 16px;
    padding-block: clamp(72px, 10vw, 160px);
    overflow: hidden;
  }

  .p-next__title {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-mega);
    line-height: 0.82;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    transition: color var(--dur-std) var(--ease-out);
  }

  .p-next__tag {
    position: relative;
    z-index: 1;
    font-size: var(--fs-h3);
    color: var(--c-bone);
  }

  .p-next__thumb {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: clamp(220px, 30vw, 520px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    transform: translateY(-50%) scale(0.92);
    opacity: 0;
    transition:
      opacity var(--dur-std) var(--ease-out),
      transform var(--dur-cine) var(--ease-out);
  }

  .p-next__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .p-next__link:hover .p-next__thumb {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  @media (max-width: 820px) {
    .p-intro,
    .p-block {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .p-title__tag {
      justify-self: start;
    }

    .p-next__thumb {
      position: relative;
      right: auto;
      top: auto;
      width: 100%;
      transform: none;
      opacity: 1;
      margin-top: 12px;
    }

    .p-next__link:hover .p-next__thumb {
      transform: none;
    }
  }
</style>

<script>
  import { initProject } from '../../scripts/project';
  initProject();
</script>
