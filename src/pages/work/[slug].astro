---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RevealText from '../../components/motion/RevealText.astro';
import { getProjects, type Project } from '../../lib/data';
import { routes, withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length], total: projects.length },
  }));
}

interface Props {
  project: Project;
  next: Project;
  index: number;
  total: number;
}

const { project, next, index, total } = Astro.props;
const p = project.data;
const num = (i: number) => String(i + 1).padStart(2, '0');

const meta = [
  { label: 'Category', value: p.category },
  p.year ? { label: 'Year', value: String(p.year), note: p.yearSource } : null,
  p.stack.length ? { label: 'Stack', value: p.stack.join(', ') } : null,
  p.members.length ? { label: 'Team', value: p.members.join(', ') } : null,
].filter(Boolean) as { label: string; value: string; note?: string }[];
---

<BaseLayout title={p.title} current="work" description={p.summary} ogImage={p.image} bodyClass="is-project">
  <script is:inline define:vars={{ slug: project.id }}>
    try {
      if (sessionStorage.getItem('just:from-gallery') === slug) document.documentElement.classList.add('from-gallery');
    } catch (e) {}
  </script>
  <article class="project" data-project={project.id}>
    <header class="project-hero" data-project-hero>
      <figure class="project-hero__media">
        <img src={withBase(p.image)} alt={p.alt} width="1280" height={Math.round(1280 / p.imageAspect)} fetchpriority="high" />
      </figure>
      <div class="project-hero__shade" aria-hidden="true"></div>
      <div class="project-hero__copy">
        <p class="t-caps project-hero__cat">{p.category}</p>
        <h1 class="project-hero__title t-display">{p.title}</h1>
      </div>
      <p class="project-hero__index t-caps t-num">{num(index)} / {String(total).padStart(2, '0')}</p>
    </header>

    <section class="project-intro container">
      <p class="section-label t-caps">Overview</p>
      <div class="project-intro__body">
        <p class="project-intro__lead reveal-fade" data-reveal>{p.summary}</p>
        <dl class="project-meta">
          {
            meta.map((m, i) => (
              <div class="reveal-fade" data-reveal style={`--delay:${i * 80}ms`}>
                <dt class="t-caps t-muted">{m.label}</dt>
                <dd>
                  {m.value}
                  {m.note && <small class="t-muted">{m.note}</small>}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="project-links">
          {
            p.links.live && (
              <a class="button" href={p.links.live} target="_blank" rel="noopener noreferrer">
                Visit live
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            )
          }
          {
            p.links.github && (
              <a class="button button--ghost" href={p.links.github} target="_blank" rel="noopener noreferrer">
                GitHub
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      p.problem && (
        <section class="project-block container">
          <p class="section-label t-caps">Problem</p>
          <p class="t-lead">{p.problem}</p>
        </section>
      )
    }

    <section class="project-screen container" aria-label="화면">
      <figure class="project-screen__frame reveal-mask" data-reveal>
        <div class="project-screen__bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.links.live?.replace(/^https?:\/\//, '')}</span></div>
        <img src={withBase(p.image)} alt={p.alt} width="1280" height={Math.round(1280 / p.imageAspect)} loading="lazy" decoding="async" data-parallax />
      </figure>
    </section>

    {
      p.features.length > 0 && (
        <section class="project-block container">
          <p class="section-label t-caps">Features</p>
          <ol class="project-features">
            {p.features.map((f, i) => (
              <li class="reveal-fade" data-reveal style={`--delay:${i * 60}ms`}>
                <span class="t-num t-muted">{num(i)}</span>
                <span>{f}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      p.process && (
        <section class="project-block container">
          <p class="section-label t-caps">Process</p>
          <p class="t-lead">{p.process}</p>
        </section>
      )
    }

    {
      p.outcomes.length > 0 && (
        <section class="project-block container">
          <p class="section-label t-caps">Outcomes</p>
          <ul class="project-features">
            {p.outcomes.map((o) => (
              <li>{o}</li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="project-next" aria-label="다음 프로젝트">
      <a href={routes.project(next.id)} class="project-next__link" data-cursor="view" data-cursor-label="NEXT">
        <span class="t-caps t-muted">Next project — {num((index + 1) % total)}</span>
        <RevealText as="p" lines={[next.data.title]} class="project-next__title t-display" />
        <span class="project-next__thumb"><img src={withBase(next.data.thumb)} alt="" loading="lazy" width="640" height="400" /></span>
      </a>
      <a class="project-next__all link-arrow container" href={routes.work}>All works</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-hero {
    position: relative;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: var(--c-bg);
  }

  .project-hero__media,
  .project-hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero__media img {
    transform-origin: 50% 40%;
  }

  .project-hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(9 10 11 / 0.92) 0%, rgb(9 10 11 / 0.35) 38%, rgb(9 10 11 / 0) 62%),
      linear-gradient(to bottom, rgb(9 10 11 / 0.55), rgb(9 10 11 / 0) 22%);
  }

  /* Mirrors the home gallery's transition overlay so the hand-off is seamless. */
  .project-hero__copy {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(40px + 6vh);
    display: grid;
    gap: 14px;
  }

  .project-hero__title {
    font-size: var(--fs-h1);
    text-shadow: 0 2px 40px rgb(0 0 0 / 0.35);
  }

  .project-hero__index {
    position: absolute;
    right: var(--gutter);
    top: calc(var(--header-h) + 12px);
    color: rgb(241 238 232 / 0.75);
  }

  .js .project-hero__media img {
    animation: hero-in 1.6s var(--ease-out) both;
  }

  .js .project-hero__shade {
    animation: fade-in 1.2s var(--ease-out) 0.2s both;
  }

  .js .project-hero__copy > * {
    animation: rise-in 1.1s var(--ease-out) both;
  }

  .js .project-hero__title {
    animation-delay: 0.12s !important;
  }

  /* Arriving from the 3D gallery: the image is already full-bleed, keep it still. */
  :global(html.from-gallery) .project-hero__media img,
  :global(html.from-gallery) .project-hero__copy > * {
    animation: none;
  }

  @keyframes hero-in {
    from {
      transform: scale(1.14);
      filter: brightness(0.4);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  .project-intro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    padding-block: var(--section-y) calc(var(--section-y) * 0.6);
  }

  .project-intro__lead {
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.75rem);
    line-height: 1.35;
    letter-spacing: -0.03em;
    margin-bottom: clamp(40px, 6vw, 80px);
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 28px 40px;
    padding-top: 28px;
    border-top: 1px solid var(--c-line);
    margin-bottom: 40px;
  }

  .project-meta dt {
    margin-bottom: 8px;
  }

  .project-meta dd small {
    display: block;
    font-size: var(--fs-micro);
    margin-top: 4px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .project-screen {
    padding-bottom: var(--section-y);
  }

  .project-screen__frame {
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
  }

  .project-screen__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--c-line);
    background: var(--c-bg-2);
  }

  .project-screen__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-surface-2);
  }

  .project-screen__bar span {
    margin-left: 14px;
    font-family: var(--font-latin);
    font-size: var(--fs-micro);
    color: var(--c-muted);
  }

  .project-screen__frame img {
    width: 100%;
  }

  .project-block {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    padding-bottom: var(--section-y);
  }

  .project-features {
    display: grid;
    border-top: 1px solid var(--c-line);
  }

  .project-features li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding-block: 22px;
    border-bottom: 1px solid var(--c-line);
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.375rem);
    letter-spacing: -0.01em;
  }

  .project-next {
    border-top: 1px solid var(--c-line);
    padding-bottom: 40px;
  }

  .project-next__link {
    position: relative;
    display: grid;
    gap: 18px;
    padding: clamp(64px, 10vw, 160px) var(--gutter) 40px;
    overflow: hidden;
  }

  .project-next__title {
    font-size: var(--fs-mega);
    line-height: 0.86;
    position: relative;
    z-index: 1;
    transition: color var(--dur-std) var(--ease-out);
  }

  .project-next__link:hover .project-next__title {
    color: var(--c-accent);
  }

  .project-next__thumb {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: clamp(160px, 22vw, 360px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-s);
    transform: translateY(-50%) rotate(4deg) scale(0.9);
    opacity: 0;
    transition:
      opacity var(--dur-std) var(--ease-out),
      transform var(--dur-cine) var(--ease-out);
  }

  .project-next__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-next__link:hover .project-next__thumb {
    opacity: 1;
    transform: translateY(-50%) rotate(-2deg) scale(1);
  }

  .project-next__all {
    display: inline-flex;
    width: auto;
    margin-left: 0;
  }

  @media (max-width: 820px) {
    .project-intro,
    .project-block {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .project-next__thumb {
      display: none;
    }
  }
</style>

<script>
  import { initProject } from '../../scripts/project';
  initProject();
</script>
