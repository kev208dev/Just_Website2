---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectThumb from "../../components/projects/ProjectThumb.astro";
import {
  awardsForProject,
  findMember,
  neighbours,
  projectImage,
  projectUrl,
  projects,
  type Project,
} from "../../lib/data";
import { url } from "../../lib/paths";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { next } = neighbours(project.slug);
const index = projects.findIndex((p) => p.slug === project.slug);
const relatedAwards = awardsForProject(project.slug);
const nextImage = projectImage(next);
// low resolution screenshots are shown whole instead of being cropped and upscaled
const smallImage = !!project.imageSize && project.imageSize[0] < 1000;
const hostOf = (href: string) => {
  try {
    return new URL(href).host.replace(/^www\./, "");
  } catch {
    return href;
  }
};

// only render sections that actually have content
const sections = [
  project.problem && { id: "problem", label: "해결하려는 문제", body: project.problem },
  project.process && { id: "process", label: "제작 과정", body: project.process },
  project.results && { id: "results", label: "성과", body: project.results },
].filter(Boolean) as { id: string; label: string; body: string }[];
---

<BaseLayout title={project.title} description={project.summary} image={projectImage(project) ?? undefined}>
  <article class="page project" data-project>
    <header class="project-head container">
      <div class="project-head__meta">
        <a class="back link-arrow" href={url("work")}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
          All work
        </a>
        <span class="eyebrow">{String(index + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</span>
      </div>
      <p class="eyebrow eyebrow--accent project-cat">{[project.category, project.year].filter(Boolean).join(" · ")}</p>
      <h1 class="project-title" data-reveal="lines">
        <span class="split-line"><span>{project.title}</span></span>
        {project.titleEn && <span class="split-line project-title__en"><span>{project.titleEn}</span></span>}
      </h1>
    </header>

    <figure class="project-hero container">
      <div class:list={["project-hero__frame", { "is-small": smallImage }]}>
        <ProjectThumb project={project} eager />
      </div>
    </figure>

    <section class="project-body container">
      <aside class="project-facts" aria-label="프로젝트 정보">
        <dl>
          <div>
            <dt>Category</dt>
            <dd>{project.category}</dd>
          </div>
          {
            project.year && (
              <div>
                <dt>Year</dt>
                <dd>{project.year}</dd>
              </div>
            )
          }
          {
            project.stack.length > 0 && (
              <div>
                <dt>Stack</dt>
                <dd>
                  <ul class="stack">
                    {project.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          {
            project.members.length > 0 && (
              <div>
                <dt>Team</dt>
                <dd>
                  {project.members.map((name) => {
                    const m = findMember(name);
                    return m ? <a class="u-link" href={`${url("people")}#member-${m.id}`}>{name}</a> : <span>{name}</span>;
                  })}
                </dd>
              </div>
            )
          }
          {
            (project.liveUrl || project.githubUrl) && (
              <div>
                <dt>Links</dt>
                <dd class="links">
                  {project.liveUrl && (
                    <a class="link-arrow" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                      Live — {project.liveUrlLabel ?? hostOf(project.liveUrl)}
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5"></path></svg>
                    </a>
                  )}
                  {project.githubUrl && (
                    <a class="link-arrow" href={project.githubUrl} target="_blank" rel="noopener noreferrer">
                      GitHub
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 12L12 4M5.5 4H12v6.5"></path></svg>
                    </a>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="project-content">
        <section class="block" aria-labelledby="overview">
          <h2 id="overview" class="eyebrow">Overview</h2>
          <p class="project-summary" data-reveal="fade">{project.summary}</p>
        </section>

        {
          project.features.length > 0 && (
            <section class="block" aria-labelledby="features">
              <h2 id="features" class="eyebrow">주요 기능</h2>
              <ol class="features" data-reveal="fade">
                {project.features.map((f, i) => (
                  <li>
                    <span class="features__num">{String(i + 1).padStart(2, "0")}</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          sections.map((s) => (
            <section class="block" aria-labelledby={s.id}>
              <h2 id={s.id} class="eyebrow">
                {s.label}
              </h2>
              <p class="block__text">{s.body}</p>
            </section>
          ))
        }

        {
          relatedAwards.length > 0 && (
            <section class="block" aria-labelledby="awards">
              <h2 id="awards" class="eyebrow">Awards archive</h2>
              <ul class="related-awards">
                {relatedAwards.map((a) => (
                  <li>
                    <a class="u-link" href={`${url("awards")}#${a.id}`}>
                      {a.source} — {a.event}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          project.archive && (
            <p class="archive-note">
              이 항목은 기존 JUST 웹사이트의 수상 아카이브에 이름으로만 기록되어 있습니다. 상세 설명·이미지·참여 멤버는 자료가 확인되는 대로
              추가됩니다.
            </p>
          )
        }
      </div>
    </section>

    <a class="next-project" href={projectUrl(next.slug)} data-cursor="view" data-cursor-label="Next">
      <div class="container next-project__inner">
        <span class="eyebrow">Next project</span>
        <span class="next-project__title">{next.title}</span>
        <span class="next-project__media" aria-hidden="true">
          {nextImage ? <img src={nextImage} alt="" loading="lazy" decoding="async" /> : <span class="next-project__type">{next.title}</span>}
        </span>
      </div>
    </a>
  </article>
</BaseLayout>

<style>
  .project-head {
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .project-head__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .back {
    font-size: 0.85rem;
    color: var(--c-muted);
    transition: color var(--d-micro);
  }

  .back:hover {
    color: var(--c-text);
  }

  .back svg {
    width: 14px;
    height: 14px;
  }

  .project-cat {
    margin-bottom: 1rem;
  }

  .project-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2.8rem, 9vw, 9.5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
  }

  .project-title__en {
    color: var(--c-muted);
    font-size: 0.42em;
    letter-spacing: -0.03em;
    margin-top: 0.3em;
  }

  .project-hero__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }

  .project-hero__frame :global(.thumb-img),
  .project-hero__frame :global(.type-thumb) {
    width: 100%;
    height: 100%;
  }

  .project-hero__frame.is-small {
    background: #0b0b0c;
  }

  .project-hero__frame.is-small :global(.thumb-img) {
    object-fit: contain;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .project-hero__frame :global(.type-thumb__title) {
    font-size: clamp(2.6rem, 8vw, 7rem);
  }

  .project-body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding-block: clamp(4rem, 9vw, 8rem) var(--section);
  }

  .project-facts {
    grid-column: 1 / span 4;
  }

  .project-facts dl {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-line);
  }

  .project-facts dl > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-line);
  }

  .project-facts dt {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-muted);
    padding-top: 0.2rem;
  }

  .project-facts dd {
    font-family: var(--f-display);
    font-size: 0.95rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .stack li {
    padding: 2px 10px;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    font-size: 0.8rem;
  }

  .links {
    display: grid;
    gap: 0.5rem;
  }

  .links a:hover {
    color: var(--c-accent);
  }

  .project-content {
    grid-column: 6 / -1;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .block .eyebrow {
    margin-bottom: 1.25rem;
  }

  .project-summary {
    font-family: var(--f-text);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  .features {
    border-top: 1px solid var(--c-line);
  }

  .features li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--c-line);
    font-size: 1.08rem;
  }

  .features__num {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    color: var(--c-accent);
    padding-top: 0.35rem;
  }

  .block__text {
    font-size: 1.08rem;
    color: rgba(241, 238, 232, 0.8);
  }

  .related-awards {
    display: grid;
    gap: 0.5rem;
  }

  .archive-note {
    padding: 1.25rem 1.4rem;
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-md);
    font-size: 0.92rem;
    color: var(--c-muted);
  }

  .next-project {
    display: block;
    border-top: 1px solid var(--c-line);
    overflow: hidden;
  }

  .next-project__inner {
    position: relative;
    display: grid;
    gap: 1rem;
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .next-project__title {
    position: relative;
    z-index: 1;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(2.6rem, 8vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    transition: color var(--d-standard) var(--ease-standard);
  }

  .next-project:hover .next-project__title {
    color: var(--c-accent);
  }

  .next-project__media {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    width: min(34vw, 460px);
    aspect-ratio: 16 / 10;
    border-radius: var(--r-md);
    overflow: hidden;
    transform: translateY(-50%) rotate(-3deg) scale(0.92);
    opacity: 0.35;
    filter: grayscale(1);
    transition:
      transform 900ms var(--ease-out),
      opacity var(--d-standard),
      filter var(--d-standard);
  }

  .next-project:hover .next-project__media {
    transform: translateY(-50%) rotate(0deg) scale(1);
    opacity: 1;
    filter: none;
  }

  .next-project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .next-project__type {
    display: grid;
    place-items: end start;
    width: 100%;
    height: 100%;
    padding: 1.25rem;
    font-weight: 700;
    font-size: 2rem;
    background: linear-gradient(135deg, #1c1d20, #0e0f10);
  }

  @media (max-width: 900px) {
    .project-facts,
    .project-content {
      grid-column: 1 / -1;
    }
    .project-facts dl {
      position: static;
    }
    .next-project__media {
      display: none;
    }
  }
</style>
