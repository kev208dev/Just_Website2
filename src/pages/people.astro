---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { awardsForMember, getAwards, getMembers, GROUP_ORDER } from '../lib/data';
import { routes, withBase } from '../lib/paths';

const members = await getMembers();
const awards = await getAwards();
const groups = GROUP_ORDER.filter((g) => members.some((m) => m.data.group === g));

const people = members.map((m, i) => {
  const won = awardsForMember(m, awards);
  return {
    id: m.id,
    index: i,
    ...m.data,
    awards: won.map((a) => ({ id: a.id, event: a.data.event, grade: a.data.grade, year: a.data.year })),
  };
});
---

<BaseLayout title="People" current="people" description="JUST를 만드는 사람들 — 23기부터 25기, One Flap까지.">
  <div class="page">
    <PageHero
      kicker="People"
      lines={['People']}
      count={`(${people.length})`}
      intro="23기부터 25기, 그리고 One Flap까지. 0에서 1을 만드는 사람들입니다."
    >
      <p class="people-hint t-caps t-muted">Tip — 이름을 더블클릭하면 별명이 보입니다</p>
    </PageHero>

    <section class="people container" data-people aria-label="멤버 목록">
      <div class="people__bar" role="group" aria-label="기수 필터">
        <button class="chip" type="button" data-group="all" aria-pressed="true">All <span class="count t-num">{people.length}</span></button>
        {
          groups.map((g) => (
            <button class="chip" type="button" data-group={g} aria-pressed="false">
              {g} <span class="count t-num">{people.filter((p) => p.group === g).length}</span>
            </button>
          ))
        }
      </div>

      {
        groups.map((g) => (
          <div class="people__group" data-group-block={g}>
            <h2 class="people__group-title t-caps">
              <span>{g}</span>
              <span class="t-muted t-num">{String(people.filter((p) => p.group === g).length).padStart(2, '0')}</span>
            </h2>
            <ul class="people__grid">
              {people
                .filter((p) => p.group === g)
                .map((p) => (
                  <li>
                    <button
                      type="button"
                      class="person"
                      data-person={p.id}
                      data-name={p.name}
                      data-nickname={p.nickname}
                      data-egg={p.easterEgg}
                      aria-haspopup="dialog"
                      data-cursor="view"
                      data-cursor-label="OPEN"
                    >
                      <span class="person__gen" aria-hidden="true">{p.group === 'One Flap' ? 'OF' : p.group.replace('기', '')}</span>
                      <span class="person__top">
                        <span class="t-num t-muted">{String(p.index + 1).padStart(2, '0')}</span>
                        {p.dept && <span class="person__dept t-caps">{p.dept}</span>}
                      </span>
                      <span class="person__name" data-name-label>{p.name}</span>
                      <span class="person__bottom">
                        <span class="person__role">{p.role ?? p.group}</span>
                        {p.awards.length > 0 && <span class="person__awards t-num">{p.awards.length} awards</span>}
                      </span>
                      <span class="person__reveal" aria-hidden="true">
                        <span class="t-caps">View profile</span>
                        <svg viewBox="0 0 12 12" width="14" height="14"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                      </span>
                    </button>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </section>

    <dialog class="profile" data-profile aria-labelledby="profile-name">
      <div class="profile__inner">
        <button class="profile__close t-caps" type="button" data-profile-close>Close ✕</button>
        <p class="profile__meta t-caps t-muted" data-profile-meta></p>
        <h2 class="profile__name t-display" id="profile-name" data-profile-name></h2>
        <p class="profile__role" data-profile-role></p>
        <button class="chip profile__nick" type="button" data-profile-nick aria-pressed="false">별명 보기</button>
        <div class="profile__section" data-profile-awards-wrap>
          <h3 class="t-caps t-muted">Awards</h3>
          <ul class="profile__awards" data-profile-awards></ul>
        </div>
      </div>
    </dialog>

    <script type="application/json" data-people-data set:html={JSON.stringify(people)} />
    <script type="application/json" data-people-config set:html={JSON.stringify({ awards: routes.awards, spider: withBase('images/people/doyeon-spider-drop.webp') })} />
  </div>
</BaseLayout>

<style>
  .people-hint {
    margin-left: auto;
  }

  .people__bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 14px;
    margin-bottom: 48px;
    background: linear-gradient(var(--c-bg) 70%, transparent);
  }

  .people__group {
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  .people__group.is-hidden {
    display: none;
  }

  .people__group-title {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    margin-bottom: 0;
    border-bottom: 1px solid var(--c-line);
  }

  .people__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    border-left: 1px solid var(--c-line);
  }

  .people__grid li {
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }

  /* Typographic member poster: generation numeral, name, role. No photos are published. */
  .person {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 20px;
    text-align: left;
    overflow: hidden;
    isolation: isolate;
    background: var(--c-bg);
    transition:
      background-color 600ms var(--ease-out),
      color 600ms var(--ease-out);
  }

  .person:hover,
  .person:focus-visible {
    background: var(--c-ivory);
    color: var(--c-ink);
  }

  .person__gen {
    position: absolute;
    right: -0.06em;
    bottom: -0.2em;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(9rem, 6rem + 9vw, 15rem);
    line-height: 1;
    letter-spacing: -0.08em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(214 208 197 / 0.14);
    transition: -webkit-text-stroke-color 600ms var(--ease-out), transform 1s var(--ease-out);
  }

  .person:hover .person__gen,
  .person:focus-visible .person__gen {
    -webkit-text-stroke-color: rgb(13 14 16 / 0.18);
    transform: translateY(-6%);
  }

  .person:hover .t-muted,
  .person:focus-visible .t-muted {
    color: var(--c-ink-muted);
  }

  .person__top,
  .person__bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--fs-small);
  }

  .person__dept {
    padding: 2px 8px;
    border: 1px solid currentColor;
    border-radius: 999px;
    opacity: 0.6;
  }

  .person__name {
    align-self: end;
    padding-bottom: 14px;
    font-size: clamp(2.3rem, 1.4rem + 2.2vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .person.is-nick .person__name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--c-bronze);
  }

  .person__role {
    color: var(--c-muted);
  }

  .person:hover .person__role,
  .person:focus-visible .person__role {
    color: var(--c-ink-muted);
  }

  .person__awards {
    color: var(--c-bronze);
  }

  .person__reveal {
    position: absolute;
    right: 20px;
    top: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-std) var(--ease-out),
      transform var(--dur-std) var(--ease-out);
  }

  .person:hover .person__reveal,
  .person:focus-visible .person__reveal {
    opacity: 1;
    transform: none;
  }

  .person:hover .person__dept,
  .person:focus-visible .person__dept {
    opacity: 0;
  }

  @media (max-width: 560px) {
    .people__grid {
      grid-template-columns: 1fr 1fr;
    }

    .person {
      padding: 14px;
    }

    .person__gen {
      font-size: 7.5rem;
    }

    .person__name {
      font-size: 1.625rem;
    }

    .person__awards,
    .person__reveal {
      display: none;
    }
  }

  .profile {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(560px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--c-line);
    background: var(--c-bg-2);
    color: var(--c-text);
    transform: translateX(100%);
    transition:
      transform 700ms var(--ease-out),
      display 700ms allow-discrete,
      overlay 700ms allow-discrete;
  }

  .profile[open] {
    transform: none;
  }

  @starting-style {
    .profile[open] {
      transform: translateX(100%);
    }
  }

  .profile::backdrop {
    background: rgb(9 10 11 / 0.6);
    backdrop-filter: blur(2px);
  }

  .profile__inner {
    display: grid;
    align-content: start;
    gap: 20px;
    min-height: 100%;
    padding: calc(var(--header-h) + 24px) clamp(24px, 4vw, 48px) 48px;
  }

  .profile__close {
    position: absolute;
    top: 22px;
    right: clamp(24px, 4vw, 48px);
    padding: 8px 0;
  }

  .profile__name {
    font-size: clamp(3.5rem, 2rem + 6vw, 6.5rem);
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    text-transform: none;
  }

  .profile__role {
    color: var(--c-muted);
  }

  .profile__nick {
    justify-self: start;
  }

  .profile__section {
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }

  .profile__awards {
    border-top: 1px solid var(--c-line);
  }

  .profile__awards :global(li a) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding-block: 14px;
    border-bottom: 1px solid var(--c-line);
    transition: color var(--dur-micro) var(--ease-out);
  }

  .profile__awards :global(li a:hover) {
    color: var(--c-accent);
  }

  .profile__awards :global(.grade) {
    color: var(--c-accent);
    font-size: var(--fs-small);
    white-space: nowrap;
  }
</style>

<script>
  import { initPeople } from '../scripts/people';
  initPeople();
</script>
